# KGS — environment variables
# Copy to `.env` for local dev, and set the same keys in the Vercel dashboard
# (Project → Settings → Environment Variables). Never commit the real .env.
#
# The publishable/anon key is safe for the browser — access is protected by
# Supabase Row Level Security. Do NOT put the service-role key here.

# Client-side (Vite injects VITE_* at build time)
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-anon-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# Server-side (SSR fallback)
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-anon-publishable-key>"
SUPABASE_PROJECT_ID="<your-project-ref>"
